#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
profile="${1:-release}"
flags=()
case "$profile" in
    release) flags+=(--release);;
    debug) ;;
    *) echo "Usage: scripts/package-macos [debug|release]" >&2; exit 2;;
esac
sherpa_lib_dir="$(./scripts/sherpa-macos)"
sparkle=$(./scripts/sparkle-macos)
repo=$(./scripts/release-repository)
VOAI_SPARKLE_SDK="$sparkle" SHERPA_ONNX_LIB_DIR="$sherpa_lib_dir" ./scripts/cargo-macos build --workspace --locked ${flags[@]+"${flags[@]}"}
build_dir="${CARGO_TARGET_DIR:-$PWD/target/native}/$profile"
distribution="${VOAI_DIST_DIR:-$PWD/target/dist/$profile}"
mkdir -p "$distribution"
stage="$(mktemp -d "$distribution/.stage.XXXXXXXX")"
trap 'rm -rf "$stage"' EXIT
app="$stage/Voai.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp packaging/Info.plist "$app/Contents/Info.plist"
mkdir -p "$app/Contents/Frameworks"
ditto "$sparkle/Sparkle.framework" "$app/Contents/Frameworks/Sparkle.framework"
if [[ -n "$repo" ]]; then
    plutil -insert SUFeedURL -string "https://github.com/$repo/releases/latest/download/appcast.xml" "$app/Contents/Info.plist"
    public_key="${VOAI_SPARKLE_PUBLIC_KEY:-$(cat packaging/sparkle-public-key.txt)}"
    plutil -insert SUPublicEDKey -string "$public_key" "$app/Contents/Info.plist"
fi
cp -R packaging/en.lproj packaging/ru.lproj "$app/Contents/Resources/"
cp packaging/Voai.icns "$app/Contents/Resources/Voai.icns"
cp -R packaging/licenses "$app/Contents/Resources/Licenses"
cp "$sparkle/LICENSE" "$app/Contents/Resources/Licenses/Sparkle-LICENSE"
cp crates/voai-speech/assets/fastenhancer/LICENSE "$app/Contents/Resources/Licenses/FastEnhancer-LICENSE"
xcrun swiftc -O -parse-as-library -target arm64-apple-macosx14.0 \
    native/MediaHelper.swift -o "$stage/voai-media-helper"
for binary in voai voai-asr-helper voai-text-helper voai-diarize voai-media-helper; do
    source="$build_dir/$binary"
    if [[ "$binary" == voai-media-helper ]]; then source="$stage/$binary"; fi
    lipo "$source" -verify_arch arm64
    install -m 755 "$source" "$app/Contents/MacOS/$binary"
    if otool -L "$source" | tail -n +2 | awk '{print $1}' | grep -Ev '^(/usr/lib/|/System/Library/)' >&2; then
        echo "$binary links to a non-system library; package it before shipping." >&2; exit 1
    fi
done
# A repository-local identity keeps macOS privacy grants valid across rebuilds.
# CI or a distribution build can override it without changing the developer's choice.
local_identity="$(git config --local --get voai.signingIdentity 2>/dev/null || true)"
identity="${VOAI_SIGN_IDENTITY:-${local_identity:--}}"
version="$(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "$app/Contents/Info.plist")"
if [[ "$("$app/Contents/MacOS/voai" --version)" != "Voai $version" ]]; then
    echo "The Rust package and Info.plist release versions differ." >&2
    exit 1
fi
team=""
if [[ "$identity" == "-" ]]; then
    echo "Using ad hoc signing. Configure voai.signingIdentity to retain macOS permissions across builds." >&2
else
    # A self-signed certificate has no Team ID, which changes library validation below.
    cp /usr/bin/true "$stage/identity-probe"
    codesign --force --sign "$identity" "$stage/identity-probe"
    team="$(codesign -dv "$stage/identity-probe" 2>&1 | sed -n 's/^TeamIdentifier=//p')"
    if [[ "$team" == "not set" ]]; then team=""; fi
    rm "$stage/identity-probe"
fi
sign=(--force --sign "$identity" --options runtime)
# Apple's timestamp service only accepts identities issued by Apple.
if [[ -n "$team" ]]; then sign+=(--timestamp); fi
framework="$app/Contents/Frameworks/Sparkle.framework"
nested="$framework/Versions/B"
for component in "$nested"/XPCServices/*.xpc "$nested/Autoupdate" "$nested/Updater.app" "$framework"; do
    codesign "${sign[@]}" --preserve-metadata=entitlements "$component"
done
for helper in voai-asr-helper voai-text-helper voai-media-helper voai-diarize; do
    codesign "${sign[@]}" "$app/Contents/MacOS/$helper"
done
entitlements=packaging/entitlements.plist
constraint=()
if [[ -z "$team" && -n "$repo" ]]; then
    # Ad hoc and self-signed code have no Team ID. Pin the bundled arm64 Sparkle
    # library and allow macOS platform libraries while keeping the hardened runtime.
    entitlements="$stage/adhoc-entitlements.plist"
    cp packaging/entitlements.plist "$entitlements"
    /usr/libexec/PlistBuddy -c 'Add :com.apple.security.cs.disable-library-validation bool true' "$entitlements"
    hash=$(codesign -d --arch arm64 --verbose=4 "$framework" 2>&1 | sed -n 's/^CDHash=//p')
    /usr/bin/python3 - "$stage/libraries.plist" "$hash" <<'PYTHON'
import plistlib, sys
cdhash = bytes.fromhex(sys.argv[2])
if len(cdhash) != 20:
    sys.exit("Cannot pin the bundled Sparkle framework")
with open(sys.argv[1], "wb") as output:
    plistlib.dump({"$or": {"validation-category": 1, "cdhash": cdhash}}, output)
PYTHON
    constraint=(--library-constraint "$stage/libraries.plist")
fi
codesign "${sign[@]}" ${constraint[@]+"${constraint[@]}"} --entitlements "$entitlements" "$app"
codesign --verify --deep --strict "$app"
if [[ -n "${VOAI_NOTARY_PROFILE:-}" ]]; then
    signing_info="$(codesign -dv --verbose=2 "$app" 2>&1)"
    if [[ "$signing_info" != *"Authority=Developer ID Application:"* ]]; then
        echo "Developer ID Application signing is required for notarization." >&2; exit 1
    fi
    ditto -c -k --keepParent "$app" "$stage/submit.zip"
    xcrun notarytool submit "$stage/submit.zip" --keychain-profile "$VOAI_NOTARY_PROFILE" --wait
    xcrun stapler staple "$app"
    xcrun stapler validate "$app"
fi
ditto -c -k --sequesterRsrc --keepParent "$app" "$stage/Voai.zip"
mkdir "$stage/disk"
ditto "$app" "$stage/disk/Voai.app"
ln -s /Applications "$stage/disk/Applications"
dmg="Voai-$version-arm64.dmg"
hdiutil create -quiet -fs HFS+ -volname Voai -format UDZO -srcfolder "$stage/disk" "$stage/$dmg"
if [[ "$identity" != "-" ]]; then
    codesign "${sign[@]}" "$stage/$dmg"
fi
if [[ -n "${VOAI_NOTARY_PROFILE:-}" ]]; then
    xcrun notarytool submit "$stage/$dmg" --keychain-profile "$VOAI_NOTARY_PROFILE" --wait
    xcrun stapler staple "$stage/$dmg"
    xcrun stapler validate "$stage/$dmg"
fi
if [[ -d "$distribution/Voai.app" ]]; then mv "$distribution/Voai.app" "$stage/previous.app"; fi
if ! mv "$app" "$distribution/Voai.app"; then
    if [[ -d "$stage/previous.app" ]]; then mv "$stage/previous.app" "$distribution/Voai.app"; fi
    exit 1
fi
mv "$stage/Voai.zip" "$distribution/Voai.zip"
mv "$stage/$dmg" "$distribution/$dmg"
printf '%s\n' "$distribution/Voai.app"
