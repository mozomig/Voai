#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."

usage() {
    echo "Usage: VOAI_SIGN_IDENTITY=<identity> [VOAI_NOTARY_PROFILE=profile] [VOAI_RELEASE_NOTES=file] $0 [--publish]"
    echo "By default, prepare the DMG, ZIP and Sparkle feed locally. Add --publish to release them on GitHub."
}
publish=false
case "$#:${1:-}" in
    0:) ;;
    1:--publish) publish=true ;;
    1:--help|1:-h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

repo=$(./scripts/release-repository)
: "${repo:?Set VOAI_RELEASE_REPOSITORY to owner/repository}"
# Every release must use the same certificate so macOS keeps privacy grants after an update.
VOAI_SIGN_IDENTITY="${VOAI_SIGN_IDENTITY:-$(git config --local --get voai.releaseIdentity 2>/dev/null || true)}"
export VOAI_SIGN_IDENTITY
: "${VOAI_SIGN_IDENTITY:?Set voai.releaseIdentity or VOAI_SIGN_IDENTITY to a Developer ID Application identity, or a self-signed release identity for an unnotarized release}"
case "$VOAI_SIGN_IDENTITY" in
    "Developer ID Application:"*)
        : "${VOAI_NOTARY_PROFILE:?Set the notarytool Keychain profile for a Developer ID release}";;
    -)
        # macOS ties privacy grants for ad hoc code to one build, so every update would reset them.
        echo "Ad hoc releases lose Accessibility and microphone access on every update. Use the release signing identity." >&2
        exit 2;;
esac

version=$(plutil -extract CFBundleShortVersionString raw packaging/Info.plist)
tag="v$version"
export VOAI_RELEASE_REPOSITORY="$repo"
export VOAI_DIST_DIR="${VOAI_DIST_DIR:-$PWD/target/dist/$tag}"
if [[ -n "${VOAI_RELEASE_NOTES:-}" && ! -s "$VOAI_RELEASE_NOTES" ]]; then
    echo "Release notes are missing or empty: $VOAI_RELEASE_NOTES" >&2; exit 2
fi

if "$publish"; then
    export GH_HOST=github.com GH_PROMPT_DISABLED=1
    # Read the release token as data, without executing the checkout's .env.
    if [[ -z "${GH_TOKEN:-}" && -z "${GITHUB_TOKEN:-}" && -f .env ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "$line" =~ ^GH_TOKEN=([A-Za-z0-9_]+)$ ]]; then
                export GH_TOKEN="${BASH_REMATCH[1]}"
                break
            fi
        done < .env
    fi
    command -v gh >/dev/null || { echo "Install GitHub CLI (gh) to publish a release." >&2; exit 1; }
    gh auth status --active --hostname "$GH_HOST" >/dev/null || {
        echo "Run gh auth login --hostname github.com or set GH_TOKEN to publish." >&2; exit 1
    }
    if [[ -n "$(git status --porcelain)" ]]; then
        echo "Commit the release source before publishing." >&2; exit 1
    fi
    commit=$(git rev-parse HEAD)
    remote_commit=$(gh api "repos/$repo/commits/$tag" --jq '.sha') || {
        echo "Push tag $tag at the release commit in $repo before publishing." >&2; exit 1
    }
    if [[ "$remote_commit" != "$commit" ]]; then
        echo "Tag $tag in $repo points to $remote_commit. Check out the tagged source." >&2; exit 1
    fi
    if gh release view "$tag" --repo "$repo" --json url >/dev/null 2>&1; then
        echo "A release or draft already exists for $tag. Inspect it with gh release view $tag --repo $repo." >&2; exit 1
    fi
fi

./scripts/package-macos
dmg="$VOAI_DIST_DIR/Voai-$version-arm64.dmg"
zip="$VOAI_DIST_DIR/Voai.zip"
./scripts/verify-macos-release "$dmg"
./scripts/verify-macos-release "$zip"
./scripts/make-appcast
feed="$VOAI_DIST_DIR/appcast.xml"

if "$publish"; then
    notes=(--generate-notes)
    if [[ -n "${VOAI_RELEASE_NOTES:-}" ]]; then
        notes=(--notes-file "$VOAI_RELEASE_NOTES")
    elif [[ -z "${VOAI_NOTARY_PROFILE:-}" ]]; then
        notes+=(--notes "This build is distributed without Apple notarization. On first launch, macOS may require approval in System Settings → Privacy & Security.")
    fi
    gh release create "$tag" "$dmg" "$zip" "$feed" --repo "$repo" --verify-tag \
        --title "Voai $version" --latest "${notes[@]}"
else
    echo "Ready for GitHub Release $tag: $dmg, $zip, $feed"
fi
