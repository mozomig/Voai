#!/bin/bash
# Check the delivered archive, including the nested helper and app version.
set -euo pipefail
cd "$(dirname "$0")/.."
archive="${1:-target/dist/release/Voai.zip}"
stage="$(mktemp -d)"
mounted=false
cleanup() {
    if [[ "$mounted" == true ]]; then hdiutil detach -quiet "$stage/mount" || return 1; fi
    rm -rf "$stage"
}
trap cleanup EXIT
case "$archive" in
    *.dmg)
        mkdir "$stage/mount"
        hdiutil attach -quiet -nobrowse -readonly -mountpoint "$stage/mount" "$archive"
        mounted=true
        [[ "$(readlink "$stage/mount/Applications")" == /Applications ]]
        app="$stage/mount/Voai.app";;
    *.zip)
        ditto -x -k "$archive" "$stage"
        app="$stage/Voai.app";;
    *) echo "Expected a Voai ZIP or DMG." >&2; exit 2;;
esac
codesign --verify --strict --deep "$app"
codesign --verify --strict --deep "$app/Contents/Frameworks/Sparkle.framework"
plutil -lint "$app/Contents/Info.plist"
for locale in en ru; do
    resources="$app/Contents/Resources/$locale.lproj"
    plutil -lint "$resources/InfoPlist.strings" "$resources/Media.strings"
    plutil -extract NSMicrophoneUsageDescription raw "$resources/InfoPlist.strings" >/dev/null
done
version="$(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "$app/Contents/Info.plist")"
for name in voai voai-asr-helper voai-text-helper voai-media-helper voai-diarize; do
    lipo "$app/Contents/MacOS/$name" -verify_arch arm64
done
[[ "$("$app/Contents/MacOS/voai" --version)" == "Voai $version" ]]
if [[ -n "${VOAI_PREVIOUS_APP:-}" ]]; then
    requirement="$(codesign -d -r- "$VOAI_PREVIOUS_APP" 2>&1 | sed -n 's/^.*designated => //p')"
    [[ -n "$requirement" ]]
    codesign --verify --strict "-R=$requirement" "$app"
fi
printf 'Verified Voai %s, arm64.\n' "$version"
shasum -a 256 "$archive"
